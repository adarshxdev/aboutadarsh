# ─────────────────────────────────────────────────────────────────────────────
# Web environment. Copy to apps/web/.env.local for local dev.
# Production: Vercel → web project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The Express API. /api/* on this site is proxied there (resolved at build time).
API_URL=http://localhost:4000

# Must equal REVALIDATE_SECRET in the API's environment.
REVALIDATE_SECRET=

# Optional: Cloudflare Turnstile site key for the contact form.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Optional: Cal.com link, e.g. "yourname/30min". Unset hides the booking card.
NEXT_PUBLIC_CAL_LINK=
