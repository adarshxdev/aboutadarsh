# ─────────────────────────────────────────────────────────────────────────────
# API environment. Copy to apps/api/.env for local dev:  cp apps/api/.env.example apps/api/.env
# Values shown are the local Docker defaults (docker compose up -d) — not secrets.
# Every variable is optional: each missing integration falls back (see README).
# Production: set these in Vercel → API project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Public site URL (links in emails, redirects, allowed Origin for admin writes).
SITE_URL=http://localhost:3000
# Where the web app is reachable from the API, for cache revalidation. Defaults to SITE_URL.
WEB_URL=
# Shared with the web app. Any long random string:  openssl rand -base64 32
REVALIDATE_SECRET=
# Extra browser origins allowed to write (comma-separated). Usually empty.
CORS_ORIGINS=

# ── Database (Postgres) ──────────────────────────────────────────────────────
# Local: Docker. Production: Supabase (use the pooler URL, port 6543) or Neon.
DATABASE_URL=postgres://portfolio:portfolio@localhost:5433/portfolio

# ── Admin login ──────────────────────────────────────────────────────────────
# Generate both hash and secret:  npm run admin:hash -- "<your password>"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# At least 32 characters.
AUTH_SECRET=

# ── File storage (any S3-compatible service) ─────────────────────────────────
# Local: RustFS in Docker. Production: Cloudflare R2, AWS S3 or Supabase Storage.
S3_BUCKET=portfolio
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
# Only when browsers must reach storage at a different address than the API does.
S3_PRESIGN_ENDPOINT=
S3_ACCESS_KEY_ID=portfolio
S3_SECRET_ACCESS_KEY=portfolio-secret
# Public base URL that files are served from (bucket URL or CDN domain).
S3_PUBLIC_URL=http://localhost:9000/portfolio
# true for RustFS/MinIO/Supabase; false for R2 and AWS.
S3_FORCE_PATH_STYLE=true
UPLOAD_MAX_MB=200

# ── Redis (rate limiting) ────────────────────────────────────────────────────
# Local: Upstash-compatible proxy in Docker. Production: Upstash (free tier).
UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=local-redis-token

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# ── Bot protection (Cloudflare Turnstile) ────────────────────────────────────
TURNSTILE_SECRET_KEY=

# Salt for hashing IPs before storage. Any long random string.
IP_HASH_SALT=
